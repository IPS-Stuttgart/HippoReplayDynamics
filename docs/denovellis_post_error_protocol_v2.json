{
  "protocol_version": "2.0",
  "analysis": "denovellis_post_error_route_balance",
  "seed": 20261001,
  "encoder_policy": "causal_within_epoch_equal_elapsed_thirds",
  "epoch_boundary_source": "first_and_last_recorded_position_timestamps",
  "exclude_boundary_crossing_traversals": true,
  "require_entire_error_to_choice_in_final_third": true,
  "development_working_days": 5,
  "well_radius_cm": 10.0,
  "max_window_s": 10.0,
  "min_exposure_s": 0.5,
  "max_tracking_gap_s": 0.25,
  "max_immobile_speed_cm_s": 4.0,
  "immobility_comparison": "strictly_less_than",
  "position_alignment_tolerance_s": 0.001,
  "min_position_annotation_agreement": 0.95,
  "min_animals": 5,
  "min_transitions": 100,
  "min_corrections": 20,
  "min_repeated_errors": 20,
  "min_recording_days_per_animal": 2,
  "require_both_outcomes_per_animal": true,
  "time_bin_s": 0.02,
  "graph_bin_cm": 3.0,
  "graph_spatial_sigma_cm": 6.0,
  "mark_sigma_native_units": 24.0,
  "min_spike_supported_bins": 5,
  "min_active_tetrodes": 2,
  "n_order_shuffles": 1000,
  "sequence_alpha": 0.05,
  "min_run_balanced_accuracy": 0.80,
  "min_run_arm_recall": 0.75,
  "validation_replicates_per_generator": 1000,
  "max_false_positive_upper95": 0.075,
  "power_odds_ratios": [1.25, 1.5, 2.0, 3.0],
  "l2_penalty": 1.0,
  "n_animal_bootstraps": 2000,
  "task_rule": "outer_to_center; center_to_less_recently_visited_outer",
  "hippocampal_areas": ["CA1", "CA2", "CA3"],
  "primary_predictor": "correct_route_rate_minus_mistaken_route_rate",
  "baseline_covariates": ["informative_content_rate", "prior_five_choice_accuracy", "consecutive_error_count", "mistaken_physical_arm", "epoch_progress", "pause_exposure_s", "native_candidate_rate", "unresolved_candidate_rate", "mark_rate", "active_tetrode_count", "run_arm_accuracy", "candidate_posterior_entropy", "entropy_missing"],
  "null_scenarios": ["history_only", "unequal_arm_preferences", "recent_path_reactivation", "asymmetric_decoding", "outcome_associated_gain", "waveform_drift", "unresolved_content", "serially_correlated_errors"],
  "sensitivities": ["post_correct_pauses", "first_five_seconds", "within_animal_day_content_reassignment"],
  "claim_boundary": "conditional predictive association in later-epoch post-error transitions; not causal replay or Bayesian smoothing"
}
